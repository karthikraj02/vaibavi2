# ==============================================================================
# FLIGHTAGENT BACKEND ENVIRONMENT VARIABLES (TEMPLATE)
# ==============================================================================
# Copy this file to `.env` in the same directory and fill in your private keys.

PORT=5000

# Database (Leave empty for automatic high-performance In-Memory MongoDB fallback)
# MONGO_URI=mongodb://localhost:27017/flightagent

# Security
JWT_SECRET=super_secret_jwt_key_12345
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_password_123

# Gmail SMTP Settings
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_APP_PASSWORD=your_gmail_app_password

# AI Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=

# Payments & Flight API Providers
STRIPE_SECRET_KEY=sk_test_51...your_stripe_secret_key
DODO_API_KEY=your_dodo_api_key
DODO_PRODUCT_ID=prod_default
AVIATION_API_KEY=your_aviation_api_key
