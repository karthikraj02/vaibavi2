# ==============================================================================
# FLIGHTAGENT BACKEND ENVIRONMENT VARIABLES (TEMPLATE)
# ==============================================================================
# Copy this file to `.env` in the same directory and fill in your private keys.

PORT=5000
NODE_ENV=development

# Database (required in production)
MONGO_URI=mongodb://127.0.0.1:27017/flightagent

# Security
JWT_SECRET=your_strong_jwt_secret_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password

# CORS (comma-separated frontend origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Gmail SMTP Settings
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password

# Google OAuth (verify ID tokens from frontend)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# AI Keys
OPENAI_API_KEY=your_openai_api_key_here

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Duffel Flights API
DUFFEL_ACCESS_TOKEN=duffel_test_your_token

# Optional
AVIATION_API_KEY=your_aviation_api_key
